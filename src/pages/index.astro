---
import Check from '@assets/check.svg'
import HeroLIEA from '@assets/img-all/Hero-LIEA.png'
import Section from '@components/atoms/common/Section.astro'
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import { PILLARS } from '../lib/const/pilares'
import { PROGRAM } from '../lib/const/program'
import { COMPANY } from '../lib/const/empresas'
import { ORGANIZATION, PARTICIPANT } from '../lib/const/que-obtienen'
import Andare from '@assets/icons/logos/andare.svg'
import Tri from '@assets/icons/logos/tri.svg'

const title = 'Liderazgo Imperfecto: guía de Jose Echeverri'
const desc =
	'Los mejores líderes no aparentan tenerlo todo bajo control. Así se ve el liderazgo imperfecto: admitir errores para ganar confianza e influencia.'

const tabButtonClass =
	'px-5 py-2 rounded-full text-base font-semibold cursor-pointer border border-cream/40 text-cream/70 transition-colors duration-300 not-aria-selected:hover:border-secondary not-aria-selected:hover:text-secondary aria-selected:border-secondary aria-selected:bg-secondary aria-selected:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary'
---

<Base title={title} description={desc}>
	<main>
		<Section class="md:h-dvh md:pt-45 md:pb-13.5">
			<div class="grid md:grid-cols-2 gap-5 h-full items-center">
				<div>
					<header aria-labelledby="hero-heading">
						<h1 id="hero-heading" class="text-heading-1 text-balance mb-6.5">
							El liderazgo que más cuesta no es el que falla, sino el que parece
							perfecto mientras <span class="font-mix text-secondary"
								>desgasta en silencio.</span
							>
						</h1>
						<p class="mb-4 text-pretty">
							Liderazgo Imperfecto en Acción propone un cambio de paradigma: de
							la apariencia de perfección a un liderazgo auténtico, consciente y
							profundamente humano.
						</p>
					</header>
					<blockquote class="italic pl-4 border-l border-l-secondary mb-6.5">
						<p>"No busques ser un líder perfecto. Busca ser un líder real."</p>
					</blockquote>
					<div class="flex flex-col md:flex-row gap-7">
						<a
							href="#"
							class="bg-secondary/45 hover:bg-secondary transition-colors duration-300 px-6 py-3 rounded-full text-base text-primary font-semibold"
							>Solicitar información</a
						>
						<a
							href="#"
							class="border border-cream text-cream hover:text-primary hover:bg-secondary transition-colors duration-300 px-6 py-3 rounded-full text-base font-semibold"
							>Conocer el programa</a
						>
					</div>
				</div>
				<div class="relative">
					<div
						class="absolute inset-0 z-20 bg-linear-to-r from-primary to-transparent">
					</div>
					<Image
						src={HeroLIEA}
						width={1672}
						height={941}
						alt="Hero de Liderazgo Imperfecto"
						format="webp"
						class="w-full aspect-video rounded-3xl"
					/>
				</div>
			</div>
		</Section>
		<Section class="py-4 md:py-13.5">
			<div class="grid md:grid-cols-2 gap-5 items-center">
				<div>
					<video src="" controls class="aspect-video w-full"></video>
				</div>
				<div>
					<header>
						<h2 class="text-heading-2 text-balance font-mix mb-6">
							Un programa que nace de la convicción de que el liderazgo
							auténtico es el que transforma, no de una tendencia.
						</h2>
						<p>
							Después de más de 20 años dirigiendo equipos y acompañando
							organizaciones, tenemos una certeza: el crecimiento sostenible
							nunca lo construyen líderes perfectos. Lo construyen los que se
							atreven a exponer sus límites y convierten cada fracaso en
							combustible para mejorar al día siguiente. En el otro extremo
							están los líderes "infalibles", que erosionan en silencio lo que
							tomó décadas construir.
						</p>
					</header>
				</div>
			</div>
		</Section>
		<Section class="py-4 md:py-13.5">
			<h2 class="text-heading-2 text-balance font-mix max-w-3xl mb-6">
				No es un curso. No es una conferencia. No es un retiro de dos días que
				se olvida.
			</h2>
			<p class="text-pretty max-w-3xl mb-4">
				El problema no es que los líderes no sepan, es la distancia entre lo que
				saben y lo que hacen.
			</p>
			<p class="text-pretty max-w-3xl">
				5 ciclos, uno por pilar: experiencias grupales, acompañamiento
				individual, contenidos asíncronos, práctica continua.
			</p>
			<div class="mt-7">
				<h3 class="text-heading-3 text-balance font-mix mb-6.5">
					Que incluye el programa
				</h3>
				<ul class="grid md:grid-cols-3 gap-5.5">
					{
						PROGRAM.map((label) => (
							<li class="bg-black/20 rounded-3xl px-7 py-5 flex items-start gap-x-3.5 w-full h-full">
								<Check class="size-4 border border-secondary p-0.5 rounded-full text-secondary mt-1 shrink-0" />
								{label.answer}
							</li>
						))
					}
				</ul>
			</div>
		</Section>
		<Section class="py-4 md:py-13.5">
			<h2 class="text-heading-2 mb-6.5 text-balance font-mix max-w-3xl">
				Cinco pilares. Un solo propósito: líderes que funcionan en el mundo
				real.
			</h2>
			<ul class="grid grid-cols-2 md:grid-cols-5 gap-4 [counter-reset:pilar]">
				{
					PILLARS.map((item) => (
						<li class="[counter-increment:pilar]">
							<article
								class="group h-full rounded-2xl bg-black/20 text-white p-6 cursor-pointer"
								data-pilar-card
								data-state="closed"
								tabindex="0"
								role="button"
								aria-expanded="false">
								<header class="flex flex-col gap-2">
									<span
										aria-hidden="true"
										class="text-sm font-bold before:content-[counter(pilar,decimal-leading-zero)] font-mix size-7 p-2 rounded-full border border-secondary text-secondary shrink-0 flex items-center justify-center"
									/>
									<h3 class="text-[20px] text-balance">{item.title}</h3>
								</header>
								<div class="grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-in-out group-data-[state=open]:grid-rows-[1fr] group-data-[state=open]:opacity-100">
									<p class="overflow-hidden mt-4.5">{item.description}</p>
								</div>
							</article>
						</li>
					))
				}
				<!-- resto de los li: el número sale solo (02, 03, 04, 05) -->
			</ul>
		</Section>
		<script>
			const cards = Array.from(
				document.querySelectorAll<HTMLElement>('[data-pilar-card]')
			)

			const closeCard = (card: HTMLElement) => {
				card.dataset.state = 'closed'
				card.setAttribute('aria-expanded', 'false')
			}

			const openCard = (card: HTMLElement) => {
				cards.forEach((other) => other !== card && closeCard(other))
				card.dataset.state = 'open'
				card.setAttribute('aria-expanded', 'true')
			}

			const toggleCard = (card: HTMLElement) => {
				card.dataset.state === 'open' ? closeCard(card) : openCard(card)
			}

			cards.forEach((card) => {
				card.addEventListener('mouseenter', () => openCard(card))
				card.addEventListener('mouseleave', () => closeCard(card))
				card.addEventListener('focus', () => openCard(card))
				card.addEventListener('blur', () => closeCard(card))
				card.addEventListener('click', () => toggleCard(card))
				card.addEventListener('keydown', (event) => {
					if (event.key === 'Enter' || event.key === ' ') {
						event.preventDefault()
						toggleCard(card)
					}
				})
			})
		</script>
		<Section class="py-4 md:py-13.5">
			<h2 class="text-heading-2 text-balance font-mix mb-6.5">
				Estamos buscando 8 compañías que:
			</h2>
			<ul
				class="max-w-250 mx-auto grid md:grid-cols-2 rounded-3xl overflow-hidden">
				{
					COMPANY.map((item) => (
						<li class="px-8 py-6 h-full w-full bg-black/10 hover:bg-black/20 transition-colors duration-300 flex items-start gap-x-3">
							<Check class="size-5 mt-1 shrink-0 border border-secondary p-1 rounded-full text-secondary" />{' '}
							{item.answer}
						</li>
					))
				}
			</ul>
		</Section>
		<Section class="py-4 md:py-13.5">
			<header>
				<h2 class="text-heading-2 text-balance mb-6.5 font-mix">
					Que obtienen
				</h2>
				<p class="text-pretty mb-5.5">
					Lo que cada líder lleva de vuelta a su organización
				</p>
			</header>
			<div
				role="tablist"
				aria-label="Ver información para"
				class="flex flex-col md:flex-row gap-5.5 mb-5.5">
				<button
					role="tab"
					id="tab-participantes"
					aria-selected="true"
					aria-controls="panel-participantes"
					class={tabButtonClass}>
					Participantes
				</button>
				<button
					role="tab"
					id="tab-organizaciones"
					aria-selected="false"
					aria-controls="panel-organizaciones"
					class={tabButtonClass}>
					Organizaciones
				</button>
			</div>

			<div
				id="panel-participantes"
				role="tabpanel"
				aria-labelledby="tab-participantes">
				<!-- lista de participantes -->
				<ul class="grid md:grid-cols-3 gap-5.5">
					{
						PARTICIPANT.map((item) => (
							<li>
								<article class="px-7 py-5 rounded-3xl bg-black/20 w-full h-full">
									<header>
										<h3 class="text-heading-5 text-balance mb-3.5 font-mix">
											{item.title}
										</h3>
									</header>
									<p class="text-pretty">{item.description}</p>
								</article>
							</li>
						))
					}
				</ul>
			</div>
			<div
				id="panel-organizaciones"
				role="tabpanel"
				aria-labelledby="tab-organizaciones"
				hidden>
				<!-- lista de organizaciones -->
				<ul class="grid md:grid-cols-3 gap-5.5">
					{
						ORGANIZATION.map((item) => (
							<li>
								<article class="px-7 py-5 rounded-3xl bg-black/20 w-full h-full">
									<header>
										<h3 class="text-heading-5 text-balance mb-3.5 font-mix">
											{item.title}
										</h3>
									</header>
									<p class="text-pretty">{item.description}</p>
								</article>
							</li>
						))
					}
				</ul>
			</div>
		</Section>
		<script>
			const tabs = Array.from(
				document.querySelectorAll<HTMLElement>('[role="tab"]')
			)
			const selectTab = (tab: HTMLElement) => {
				tabs.forEach((t) => t.setAttribute('aria-selted', String(t === tab)))
				tabs.forEach((t) => {
					const panel = document.getElementById(
						t.getAttribute('aria-controls')!
					)
					panel?.toggleAttribute('hidden', t !== tab)
				})
			}
			tabs.forEach((tab) => {
				tab.addEventListener('click', () => selectTab(tab))
			})

			tabs.forEach((tab, index) => {
				tab.addEventListener('keydown', (event) => {
					if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft')
						return event.preventDefault()
					const next =
						event.key === 'ArrowRight'
							? tabs[(index + 1) % tabs.length]
							: tabs[(index - 1 + tabs.length) % tabs.length]
					next.focus()
					selectTab(next)
				})
			})
		</script>
		<Section class="py-4 md:py-13.5">
			<h2 class="text-heading-2 text-balance font-mix mb-6.5 text-center">
				Aliados
			</h2>
			<ul class="flex flex-wrap items-center justify-center gap-5">
				<li>
					<a
						href=""
						class="flex items-center justify-center rounded-3xl bg-black/20 px-10 py-8 opacity-70 transition-[opacity,background-color] duration-300 hover:bg-black/30 hover:opacity-100 focus-visible:opacity-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary">
						<Andare class="h-6 w-auto" />
					</a>
				</li>
				<li>
					<a
						href=""
						class="flex items-center justify-center rounded-3xl bg-black/20 px-10 py-8 opacity-70 transition-[opacity,background-color] duration-300 hover:bg-black/30 hover:opacity-100 focus-visible:opacity-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary">
						<Tri class="h-11 w-auto" />
					</a>
				</li>
			</ul>
		</Section>
		<Section class="py-4 md:py-13.5">
			<div
				class="max-w-250 mx-auto text-center flex flex-col items-center justify-center rounded-3xl bg-secondary text-primary px-10 py-8 relative overflow-hidden">
				<div
					aria-hidden="true"
					class="bg-noise absolute inset-0 z-0 m-auto aspect-square w-[60%] rounded-full bg-accent opacity-50 blur-3xl mix-blend-multiply">
				</div>
				<h2 class="relative z-10 text-heading-2 mb-5.5 text-balance font-mix">
					Primera cohorte: ocho organizaciones, un proceso único.
				</h2>
				<p class="relative z-10">
					No es una restricción de capacidad — es una decisión de calidad. Ocho
					empresas. Ocho conversaciones distintas.
				</p>
				<p class="relative z-10 my-4.5 font-mix font-bold text-3xl">8</p>
				<p class="relative z-10">empresas · primera cohorte</p>
				<a
					href="#"
					class="relative z-10 m-5.5 bg-primary text-cream font-semibold px-7 py-4.5 rounded-full shadow-md shadow-primary/30 transition-[transform,box-shadow] duration-300 hover:-translate-y-1.5 hover:shadow-lg hover:shadow-primary/40"
					>QUIERO EXPLORAR SI MI EMPRESA PUEDE SER PARTE →</a
				>
			</div>
		</Section>
	</main>
	<!-- {
		faqs.map((faq) => (
			<div>
				<h3>{faq.question}</h3>
				<p>{faq.answer}</p>
			</div>
		))
	} -->
	<!-- <script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: faqs.map((faq) => ({
				'@type': 'Question',
				name: faq.question,
				acceptedAnswer: { '@type': 'Answer', text: faq.answer }
			}))
		})}
	/> -->
</Base>
