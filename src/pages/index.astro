---
import Base from '../layouts/Base.astro'

import Alianza from '@components/atoms/organims/index/Alianza.astro'
import Company from '@components/atoms/organims/index/Company.astro'
import ContactForm from '@components/atoms/organims/index/ContactForm.astro'
import Cta from '@components/atoms/organims/index/Cta.astro'
import Faq from '@components/atoms/organims/index/Faq.astro'
import Hero from '@components/atoms/organims/index/hero.astro'
import Pilars from '@components/atoms/organims/index/Pilars.astro'
import Program from '@components/atoms/organims/index/Program.astro'
import QueObtienen from '@components/atoms/organims/index/QueObtienen.astro'
import VideoInvitacion from '@components/atoms/organims/index/VideoInvitacion.astro'

const title = 'Liderazgo Imperfecto: guía de Jose Echeverri'
const desc =
	'Los mejores líderes no aparentan tenerlo todo bajo control. Así se ve el liderazgo imperfecto: admitir errores para ganar confianza e influencia.'

// Campos del formulario de HubSpot (portalId 46019030 / formId 26c4f60d-fea9-43af-b572-a701a8c8ab28)
---

<Base title={title} description={desc}>
	<main>
		<Hero />
		<VideoInvitacion />
		<Program />
		<Pilars />
		<Company />
		<QueObtienen />
		<Alianza />
		<Cta />
		<ContactForm />
		<Faq />
	</main>
</Base>
