---
import Check from '@assets/check.svg'
import HeroLIEA from '@assets/img-all/Hero-LIEA.png'
import Section from '@components/atoms/common/Section.astro'
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import { PILLARS } from '../lib/const/pilares'
import { PROGRAM } from '../lib/const/program'
import { COMPANY } from '../lib/const/empresas'
import { ORGANIZATION, PARTICIPANT } from '../lib/const/que-obtienen'
import Andare from '@assets/icons/logos/andare.svg'
import Tri from '@assets/icons/logos/tri.svg'
import { faq } from '../lib/const/faq'

const title = 'Liderazgo Imperfecto: guía de Jose Echeverri'
const desc =
	'Los mejores líderes no aparentan tenerlo todo bajo control. Así se ve el liderazgo imperfecto: admitir errores para ganar confianza e influencia.'

const tabButtonClass =
	'px-5 py-2 rounded-full text-base font-semibold cursor-pointer border border-cream/40 text-cream/70 transition-colors duration-300 not-aria-selected:hover:border-secondary not-aria-selected:hover:text-secondary aria-selected:border-secondary aria-selected:bg-secondary aria-selected:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary'

// Campos del formulario de HubSpot (portalId 46019030 / formId 26c4f60d-fea9-43af-b572-a701a8c8ab28)
const CARGO_OPTIONS = [
	'CEO / Founder',
	'Presidente / VP',
	'Gerente General',
	'Director De Recursos Humanos',
	'Lider / Director área',
	'Otro',
]
const PAIS_OPTIONS = [
	'Costa Rica',
	'Honduras',
	'Nicaragua',
	'Mexico',
	'Panama',
	'Puerto Rico',
	'El Salvador',
	'Dominican Republic',
]
const LIDERES_OPTIONS = ['Solo yo', '2 a 5', '6 a 15', '16 a 30', '31 a 50', 'Más de 50']

const fieldClass =
	'w-full rounded-full border border-cream/40 bg-cream/10 px-6 py-3.5 text-cream placeholder:text-cream/50 outline-none transition-colors duration-300 focus:border-secondary focus:bg-cream/15'
const textareaClass = `${fieldClass} rounded-3xl resize-none`
const selectArrow = `bg-[url('data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2024%2024%22%20fill=%22none%22%20stroke=%22%23fee6d4%22%20stroke-width=%222%22%20stroke-linecap=%22round%22%20stroke-linejoin=%22round%22%3E%3Cpolyline%20points=%226%209%2012%2015%2018%209%22/%3E%3C/svg%3E')] bg-no-repeat bg-[right_1.5rem_center] bg-[length:1rem] pr-12`
const selectClass = `${fieldClass} cursor-pointer appearance-none ${selectArrow}`
---

<Base title={title} description={desc}>
	<main>
		<Section class="md:h-dvh md:pt-45 md:pb-13.5">
			<div class="grid md:grid-cols-2 gap-5 h-full items-center">
				<div>
					<header aria-labelledby="hero-heading">
						<h1 id="hero-heading" class="text-heading-1 text-balance mb-6.5">
							El liderazgo que más cuesta no es el que falla, sino el que parece
							perfecto mientras <span class="font-mix text-secondary"
								>desgasta en silencio.</span
							>
						</h1>
						<p class="mb-4 text-pretty">
							Liderazgo Imperfecto en Acción propone un cambio de paradigma: de
							la apariencia de perfección a un liderazgo auténtico, consciente y
							profundamente humano.
						</p>
					</header>
					<blockquote class="italic pl-4 border-l border-l-secondary mb-6.5">
						<p>"No busques ser un líder perfecto. Busca ser un líder real."</p>
					</blockquote>
					<div class="flex flex-col md:flex-row gap-7">
						<a
							href="#"
							class="bg-secondary/45 hover:bg-secondary transition-colors duration-300 px-6 py-3 rounded-full text-base text-primary font-semibold"
							>Solicitar información</a
						>
						<a
							href="#"
							class="border border-cream text-cream hover:text-primary hover:bg-secondary transition-colors duration-300 px-6 py-3 rounded-full text-base font-semibold"
							>Conocer el programa</a
						>
					</div>
				</div>
				<div class="relative">
					<div
						class="absolute inset-0 z-20 bg-linear-to-r from-primary to-transparent">
					</div>
					<Image
						src={HeroLIEA}
						width={1672}
						height={941}
						alt="Hero de Liderazgo Imperfecto"
						format="webp"
						class="w-full aspect-video rounded-3xl"
					/>
				</div>
			</div>
		</Section>
		<Section class="py-4 md:py-13.5">
			<div class="grid md:grid-cols-2 gap-5 items-center">
				<div>
					<video src="" controls class="aspect-video w-full"></video>
				</div>
				<div>
					<header>
						<h2 class="text-heading-2 text-balance font-mix mb-6">
							Un programa que nace de la convicción de que el liderazgo
							auténtico es el que transforma, no de una tendencia.
						</h2>
						<p>
							Después de más de 20 años dirigiendo equipos y acompañando
							organizaciones, tenemos una certeza: el crecimiento sostenible
							nunca lo construyen líderes perfectos. Lo construyen los que se
							atreven a exponer sus límites y convierten cada fracaso en
							combustible para mejorar al día siguiente. En el otro extremo
							están los líderes "infalibles", que erosionan en silencio lo que
							tomó décadas construir.
						</p>
					</header>
				</div>
			</div>
		</Section>
		<Section class="py-4 md:py-13.5">
			<h2 class="text-heading-2 text-balance font-mix max-w-3xl mb-6">
				No es un curso. No es una conferencia. No es un retiro de dos días que
				se olvida.
			</h2>
			<p class="text-pretty max-w-3xl mb-4">
				El problema no es que los líderes no sepan, es la distancia entre lo que
				saben y lo que hacen.
			</p>
			<p class="text-pretty max-w-3xl">
				5 ciclos, uno por pilar: experiencias grupales, acompañamiento
				individual, contenidos asíncronos, práctica continua.
			</p>
			<div class="mt-7">
				<h3 class="text-heading-3 text-balance font-mix mb-6.5">
					Que incluye el programa
				</h3>
				<ul class="grid md:grid-cols-3 gap-5.5">
					{
						PROGRAM.map((label) => (
							<li class="bg-black/20 rounded-3xl px-7 py-5 flex items-start gap-x-3.5 w-full h-full">
								<Check class="size-4 border border-secondary p-0.5 rounded-full text-secondary mt-1 shrink-0" />
								{label.answer}
							</li>
						))
					}
				</ul>
			</div>
		</Section>
		<Section class="py-4 md:py-13.5">
			<h2 class="text-heading-2 mb-6.5 text-balance font-mix max-w-3xl">
				Cinco pilares. Un solo propósito: líderes que funcionan en el mundo
				real.
			</h2>
			<ul class="grid grid-cols-2 md:grid-cols-5 gap-4 [counter-reset:pilar]">
				{
					PILLARS.map((item) => (
						<li class="[counter-increment:pilar]">
							<article
								class="group h-full rounded-2xl bg-black/20 text-white p-6 cursor-pointer"
								data-pilar-card
								data-state="closed"
								tabindex="0"
								role="button"
								aria-expanded="false">
								<header class="flex flex-col gap-2">
									<span
										aria-hidden="true"
										class="text-sm font-bold before:content-[counter(pilar,decimal-leading-zero)] font-mix size-7 p-2 rounded-full border border-secondary text-secondary shrink-0 flex items-center justify-center"
									/>
									<h3 class="text-[20px] text-balance">{item.title}</h3>
								</header>
								<div class="grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-in-out group-data-[state=open]:grid-rows-[1fr] group-data-[state=open]:opacity-100">
									<p class="overflow-hidden mt-4.5">{item.description}</p>
								</div>
							</article>
						</li>
					))
				}
				<!-- resto de los li: el número sale solo (02, 03, 04, 05) -->
			</ul>
		</Section>
		<script>
			const cards = Array.from(
				document.querySelectorAll<HTMLElement>('[data-pilar-card]')
			)

			const closeCard = (card: HTMLElement) => {
				card.dataset.state = 'closed'
				card.setAttribute('aria-expanded', 'false')
			}

			const openCard = (card: HTMLElement) => {
				cards.forEach((other) => other !== card && closeCard(other))
				card.dataset.state = 'open'
				card.setAttribute('aria-expanded', 'true')
			}

			const toggleCard = (card: HTMLElement) => {
				card.dataset.state === 'open' ? closeCard(card) : openCard(card)
			}

			cards.forEach((card) => {
				card.addEventListener('mouseenter', () => openCard(card))
				card.addEventListener('mouseleave', () => closeCard(card))
				card.addEventListener('focus', () => openCard(card))
				card.addEventListener('blur', () => closeCard(card))
				card.addEventListener('click', () => toggleCard(card))
				card.addEventListener('keydown', (event) => {
					if (event.key === 'Enter' || event.key === ' ') {
						event.preventDefault()
						toggleCard(card)
					}
				})
			})
		</script>
		<Section class="py-4 md:py-13.5">
			<h2 class="text-heading-2 text-balance font-mix mb-6.5">
				Estamos buscando 8 compañías que:
			</h2>
			<ul
				class="max-w-250 mx-auto grid md:grid-cols-2 rounded-3xl overflow-hidden">
				{
					COMPANY.map((item) => (
						<li class="px-8 py-6 h-full w-full bg-black/10 hover:bg-black/20 transition-colors duration-300 flex items-start gap-x-3">
							<Check class="size-5 mt-1 shrink-0 border border-secondary p-1 rounded-full text-secondary" />{' '}
							{item.answer}
						</li>
					))
				}
			</ul>
		</Section>
		<Section class="py-4 md:py-13.5">
			<header>
				<h2 class="text-heading-2 text-balance mb-6.5 font-mix">
					Que obtienen
				</h2>
				<p class="text-pretty mb-5.5">
					Lo que cada líder lleva de vuelta a su organización
				</p>
			</header>
			<div
				role="tablist"
				aria-label="Ver información para"
				class="flex flex-col md:flex-row gap-5.5 mb-5.5">
				<button
					role="tab"
					id="tab-participantes"
					aria-selected="true"
					aria-controls="panel-participantes"
					class={tabButtonClass}>
					Participantes
				</button>
				<button
					role="tab"
					id="tab-organizaciones"
					aria-selected="false"
					aria-controls="panel-organizaciones"
					class={tabButtonClass}>
					Organizaciones
				</button>
			</div>

			<div
				id="panel-participantes"
				role="tabpanel"
				aria-labelledby="tab-participantes">
				<!-- lista de participantes -->
				<ul class="grid md:grid-cols-3 gap-5.5">
					{
						PARTICIPANT.map((item) => (
							<li>
								<article class="px-7 py-5 rounded-3xl bg-black/20 w-full h-full">
									<header>
										<h3 class="text-heading-5 text-balance mb-3.5 font-mix">
											{item.title}
										</h3>
									</header>
									<p class="text-pretty">{item.description}</p>
								</article>
							</li>
						))
					}
				</ul>
			</div>
			<div
				id="panel-organizaciones"
				role="tabpanel"
				aria-labelledby="tab-organizaciones"
				hidden>
				<!-- lista de organizaciones -->
				<ul class="grid md:grid-cols-3 gap-5.5">
					{
						ORGANIZATION.map((item) => (
							<li>
								<article class="px-7 py-5 rounded-3xl bg-black/20 w-full h-full">
									<header>
										<h3 class="text-heading-5 text-balance mb-3.5 font-mix">
											{item.title}
										</h3>
									</header>
									<p class="text-pretty">{item.description}</p>
								</article>
							</li>
						))
					}
				</ul>
			</div>
		</Section>
		<script>
			const tabs = Array.from(
				document.querySelectorAll<HTMLElement>('[role="tab"]')
			)
			const selectTab = (tab: HTMLElement) => {
				tabs.forEach((t) => t.setAttribute('aria-selted', String(t === tab)))
				tabs.forEach((t) => {
					const panel = document.getElementById(
						t.getAttribute('aria-controls')!
					)
					panel?.toggleAttribute('hidden', t !== tab)
				})
			}
			tabs.forEach((tab) => {
				tab.addEventListener('click', () => selectTab(tab))
			})

			tabs.forEach((tab, index) => {
				tab.addEventListener('keydown', (event) => {
					if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft')
						return event.preventDefault()
					const next =
						event.key === 'ArrowRight'
							? tabs[(index + 1) % tabs.length]
							: tabs[(index - 1 + tabs.length) % tabs.length]
					next.focus()
					selectTab(next)
				})
			})
		</script>
		<Section class="py-4 md:py-13.5">
			<h2 class="text-heading-2 text-balance font-mix mb-6.5 text-center">
				Aliados
			</h2>
			<ul class="flex flex-wrap items-center justify-center gap-5">
				<li>
					<a
						href=""
						class="flex items-center justify-center rounded-3xl bg-black/20 px-10 py-8 opacity-70 transition-[opacity,background-color] duration-300 hover:bg-black/30 hover:opacity-100 focus-visible:opacity-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary">
						<Andare class="h-6 w-auto" />
					</a>
				</li>
				<li>
					<a
						href=""
						class="flex items-center justify-center rounded-3xl bg-black/20 px-10 py-8 opacity-70 transition-[opacity,background-color] duration-300 hover:bg-black/30 hover:opacity-100 focus-visible:opacity-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary">
						<Tri class="h-11 w-auto" />
					</a>
				</li>
			</ul>
		</Section>
		<Section class="py-4 md:py-13.5">
			<div
				class="max-w-250 mx-auto text-center flex flex-col items-center justify-center rounded-3xl bg-secondary text-primary px-10 py-8 relative overflow-hidden">
				<div
					aria-hidden="true"
					class="bg-noise absolute inset-0 z-0 m-auto aspect-square w-[60%] rounded-full bg-accent opacity-50 blur-3xl mix-blend-multiply">
				</div>
				<h2 class="relative z-10 text-heading-2 mb-5.5 text-balance font-mix">
					Primera cohorte: ocho organizaciones, un proceso único.
				</h2>
				<p class="relative z-10">
					No es una restricción de capacidad — es una decisión de calidad. Ocho
					empresas. Ocho conversaciones distintas.
				</p>
				<p class="relative z-10 my-4.5 font-mix font-bold text-3xl">8</p>
				<p class="relative z-10">empresas · primera cohorte</p>
				<a
					href="#"
					class="relative z-10 m-5.5 bg-primary text-cream font-semibold px-7 py-4.5 rounded-full shadow-md shadow-primary/30 transition-[transform,box-shadow] duration-300 hover:-translate-y-1.5 hover:shadow-lg hover:shadow-primary/40"
					>QUIERO EXPLORAR SI MI EMPRESA PUEDE SER PARTE →</a
				>
			</div>
		</Section>
		<Section class="py-4 md:py-13.5">
			<h2 class="text-heading-2 text-balance font-mix mb-6.5 text-center">
				Preguntas frecuentes
			</h2>
			<div class="max-w-3xl mx-auto space-y-4.5 [counter-reset:faq]">
				{
					faq.map((item) => (
						<details
							name="faq"
							class="group [counter-increment:faq] bg-secondary text-primary rounded-3xl px-7 py-4 open:pb-5.5">
							<summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-semibold text-pretty focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
								<span class="flex gap-2.5">
									<span
										aria-hidden="true"
										class="font-mix shrink-0 before:content-[counter(faq,decimal-leading-zero)_'.']"
									/>
									<span>{item.question}</span>
								</span>
								<span aria-hidden="true" class="relative size-5 mt-1 shrink-0">
									<span class="absolute inset-0 m-auto h-0.5 w-3.5 rounded-full bg-primary" />
									<span class="absolute inset-0 m-auto h-3.5 w-0.5 rounded-full bg-primary transition-transform duration-300 group-open:rotate-90" />
								</span>
							</summary>
							<div class="bg-cream rounded-2xl p-4 mt-4">
								<p class="text-pretty">{item.answer}</p>
							</div>
						</details>
					))
				}
			</div>
			<footer>
				<div class="max-w-lg mx-auto text-center mt-7">
					<p>
						¿Tienes otra pregunta? Escríbenos a <a
							href="mailto:liea@joseecheverri.com"
							class="text-accent">liea@joseecheverri.com</a
						> o por WhatsApp <span class="text-accent font-semibold font-mix"
							>+57 333 278 5508</span
						> — te respondemos en menos de 24 horas.
					</p>
				</div>
			</footer>
		</Section>
		<Section id="solicitar-informacion" class="py-4 md:py-13.5">
			<div class="max-w-3xl mx-auto rounded-3xl border border-cream/25 p-6 md:p-10">
				<header class="mb-6.5 text-center">
					<h2 class="text-heading-2 text-balance font-mix">
						Solicita información para tu organización
					</h2>
				</header>
				<form id="lead-form" novalidate class="space-y-4">
					<div class="grid gap-4 sm:grid-cols-2">
						<div>
							<label for="lead-form-firstname" class="sr-only"
								>Nombre completo</label
							>
							<input
								id="lead-form-firstname"
								name="firstname"
								type="text"
								required
								placeholder="Nombre completo"
								class={fieldClass}
							/>
						</div>
						<div>
							<label for="lead-form-email" class="sr-only"
								>Correo corporativo</label
							>
							<input
								id="lead-form-email"
								name="email"
								type="email"
								required
								placeholder="Correo corporativo"
								class={fieldClass}
							/>
						</div>
						<div>
							<label for="lead-form-company" class="sr-only"
								>Nombre de la empresa</label
							>
							<input
								id="lead-form-company"
								name="company"
								type="text"
								required
								placeholder="Nombre de la empresa"
								class={fieldClass}
							/>
						</div>
						<div>
							<label for="lead-form-cargo" class="sr-only">Cargo</label>
							<select
								id="lead-form-cargo"
								name="cargo_o_rol"
								required
								class={selectClass}>
								<option value="" disabled selected>Cargo</option>
								{
									CARGO_OPTIONS.map((option) => (
										<option value={option}>{option}</option>
									))
								}
							</select>
						</div>
						<div>
							<label for="lead-form-pais" class="sr-only">País</label>
							<select
								id="lead-form-pais"
								name="pais"
								required
								class={selectClass}>
								<option value="" disabled selected>País</option>
								{
									PAIS_OPTIONS.map((option) => (
										<option value={option}>{option}</option>
									))
								}
							</select>
						</div>
						<div>
							<label for="lead-form-ciudad" class="sr-only"
								>Ciudad / país</label
							>
							<input
								id="lead-form-ciudad"
								name="ciudad__pais"
								type="text"
								required
								placeholder="Ciudad / país"
								class={fieldClass}
							/>
						</div>
						<div class="sm:col-span-2">
							<label for="lead-form-lideres" class="sr-only"
								>¿Cuántos líderes participarán?</label
							>
							<select
								id="lead-form-lideres"
								name="cuantos_lideres_participaran"
								required
								class={selectClass}>
								<option value="" disabled selected>
									¿Cuántos líderes participarán?
								</option>
								{
									LIDERES_OPTIONS.map((option) => (
										<option value={option}>{option}</option>
									))
								}
							</select>
						</div>
					</div>
					<div>
						<label for="lead-form-reto" class="sr-only"
							>Principal reto de liderazgo en su organización</label
						>
						<textarea
							id="lead-form-reto"
							name="principal_reto_de_liderazgo_en_su_organizacion"
							required
							rows={3}
							placeholder="Principal reto de liderazgo en su organización"
							class={textareaClass}
						></textarea>
					</div>
					<label class="flex items-start gap-3 text-sm text-cream/80">
						<input
							id="lead-form-consent"
							type="checkbox"
							required
							class="mt-1 size-4 shrink-0 rounded border-cream/40 bg-cream/10 accent-secondary"
						/>
						Acepto la Política de Tratamiento de Datos Personales (Ley 1581/2012)
					</label>
					<button
						id="lead-form-submit"
						type="submit"
						class="w-full bg-secondary hover:bg-secondary/80 transition-colors duration-300 px-6 py-4 rounded-full text-base text-primary font-bold tracking-wide">
						SOLICITAR INFORMACIÓN →
					</button>
					<p
						id="lead-form-message"
						role="status"
						aria-live="polite"
						class="text-center text-sm text-cream"
					>
					</p>
				</form>
			</div>
		</Section>
		<style>
			#lead-form select option {
				color: var(--color-primary);
				background-color: var(--color-cream);
			}
		</style>
		<script>
			const HUBSPOT_PORTAL_ID = '46019030'
			const HUBSPOT_FORM_ID = '26c4f60d-fea9-43af-b572-a701a8c8ab28'

			const FREE_EMAIL_DOMAINS = new Set([
				'gmail.com',
				'googlemail.com',
				'hotmail.com',
				'hotmail.es',
				'hotmail.co.uk',
				'outlook.com',
				'outlook.es',
				'live.com',
				'live.com.mx',
				'yahoo.com',
				'yahoo.es',
				'icloud.com',
				'me.com',
				'mac.com',
				'aol.com',
				'protonmail.com',
				'proton.me',
				'gmx.com',
				'gmx.net',
				'zoho.com',
				'yandex.com',
				'yandex.ru',
				'mail.com',
				'mailinator.com',
				'terra.com',
				'terra.com.co',
			])

			const form = document.querySelector<HTMLFormElement>('#lead-form')
			const emailInput =
				form?.querySelector<HTMLInputElement>('#lead-form-email')
			const submitButton =
				form?.querySelector<HTMLButtonElement>('#lead-form-submit')
			const messageEl =
				form?.querySelector<HTMLParagraphElement>('#lead-form-message')

			const getEmailDomain = (value: string) =>
				value.split('@')[1]?.toLowerCase().trim() ?? ''

			const validateCorporateEmail = () => {
				if (!emailInput) return
				const domain = getEmailDomain(emailInput.value)
				const isFreeEmail = domain !== '' && FREE_EMAIL_DOMAINS.has(domain)
				emailInput.setCustomValidity(
					isFreeEmail
						? 'Usa tu correo corporativo, no un correo personal (Gmail, Hotmail, etc.).'
						: ''
				)
			}

			emailInput?.addEventListener('input', validateCorporateEmail)

			const getHubspotTrackingCookie = () =>
				document.cookie.match(/(?:^|;\s*)hubspotutk=([^;]+)/)?.[1]

			form?.addEventListener('submit', async (event) => {
				event.preventDefault()
				validateCorporateEmail()
				if (!form.reportValidity()) return

				const fields = Array.from(
					form.querySelectorAll<
						HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
					>('[name]')
				).map((field) => ({ name: field.name, value: field.value }))

				if (submitButton) {
					submitButton.disabled = true
					submitButton.textContent = 'Enviando…'
				}
				if (messageEl) messageEl.textContent = ''

				try {
					const response = await fetch(
						`https://api.hsforms.com/submissions/v3/integration/submit/${HUBSPOT_PORTAL_ID}/${HUBSPOT_FORM_ID}`,
						{
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								fields,
								context: {
									pageUri: window.location.href,
									pageName: document.title,
									hutk: getHubspotTrackingCookie(),
								},
							}),
						}
					)

					if (!response.ok) throw new Error('submit failed')

					form.reset()
					if (messageEl) {
						messageEl.textContent =
							'Gracias por enviar el formulario. Te contactaremos pronto.'
						messageEl.classList.remove('text-red-200')
						messageEl.classList.add('text-cream')
					}
				} catch (error) {
					if (messageEl) {
						messageEl.textContent =
							'No pudimos enviar el formulario. Inténtalo de nuevo en unos minutos.'
						messageEl.classList.remove('text-cream')
						messageEl.classList.add('text-red-200')
					}
				} finally {
					if (submitButton) {
						submitButton.disabled = false
						submitButton.textContent = 'SOLICITAR INFORMACIÓN →'
					}
				}
			})
		</script>
	</main>
</Base>
