---
import Section from '@components/atoms/common/Section.astro'
import { ORGANIZATION, PARTICIPANT } from '../../../../lib/const/que-obtienen'
---

<Section class="py-4 md:py-13.5">
	<header>
		<h2 class="text-heading-2 text-balance mb-6.5 font-mix">Que obtienen</h2>
		<p class="text-pretty mb-5.5">
			Lo que cada líder lleva de vuelta a su organización
		</p>
	</header>

	<div>
		<div class="grid md:grid-cols-2 gap-7">
			<div>
				<h3 class="my-5.5 text-heading-5">Participantes</h3>
				<ul
					class="space-y-5 bg-black/20 border border-black/28 px-7 py-5 rounded-2xl">
					{
						PARTICIPANT.map((item) => (
							<li>
								<article>
									<header>
										<h4 class="text-heading-5 text-balance mb-3.5 font-mix">
											{item.title}
										</h4>
									</header>
									<p class="text-pretty">{item.description}</p>
								</article>
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<h3 class="my-5.5 text-heading-5">Organizaciones</h3>
				<ul
					class="space-y-5 bg-black/20 border border-black/28 px-7 py-5 rounded-2xl">
					{
						ORGANIZATION.map((item) => (
							<li>
								<article>
									<header>
										<h4 class="text-heading-5 text-balance mb-3.5 font-mix">
											{item.title}
										</h4>
									</header>
									<p class="text-pretty">{item.description}</p>
								</article>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</Section>
