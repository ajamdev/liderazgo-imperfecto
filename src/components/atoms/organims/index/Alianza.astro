---
import Andare from '@assets/icons/logos/andare.svg'
import Tri from '@assets/icons/logos/tri.svg'
import Section from '@components/atoms/common/Section.astro'
---

<Section class="py-4 md:py-13.5">
	<h2 class="text-heading-2 text-balance font-mix mb-6.5 text-center">
		Aliados para la implementación
	</h2>
	<ul class="flex flex-wrap items-center justify-center gap-5">
		<li>
			<a
				href="/andare"
				class="flex items-center justify-center rounded-3xl bg-black/20 px-10 py-8 opacity-70 transition-[opacity,background-color] duration-300 hover:bg-black/30 hover:opacity-100 focus-visible:opacity-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary">
				<Andare class="h-6 w-auto" />
			</a>
		</li>
		<li>
			<a
				href="/tri"
				class="flex items-center justify-center rounded-3xl bg-black/20 px-10 py-8 opacity-70 transition-[opacity,background-color] duration-300 hover:bg-black/30 hover:opacity-100 focus-visible:opacity-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary">
				<Tri class="h-11 w-auto" />
			</a>
		</li>
	</ul>
</Section>
